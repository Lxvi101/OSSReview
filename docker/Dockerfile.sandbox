# GitHub Code Reviewer — per-review sandbox.
#
# Goals:
#   - The smallest possible attack surface that can run the Claude Code SDK.
#   - Read-only root, non-root user, no shell-on-PATH, no package manager.
#   - The container's only externally-supplied input is the JSON request on stdin.
#
# Runtime invariants (enforced by SandboxRunner, not by this Dockerfile):
#   - --read-only     no writes outside /tmp + /workspace tmpfs
#   - --cap-drop=ALL  no capabilities
#   - --security-opt=no-new-privileges
#   - --security-opt=seccomp=docker/seccomp-claude.json
#   - --network=gcr-egress (egress firewall)
#   - --user=10001:10001
#   - --pids-limit=256 --memory=4g --cpus=2
#
# In production, this image is built once per release and pinned by digest in
# the SANDBOX_IMAGE env var.

ARG NODE_VERSION=20.11.0

# ── build ─────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION}-bookworm-slim AS build
# Install pnpm directly rather than via corepack — see Dockerfile.app for
# the full reasoning. Same version as the workspace's `packageManager`.
RUN npm install -g pnpm@9.12.0
WORKDIR /repo

# Install workspace deps. We need every package's manifest to satisfy the
# pnpm workspace resolver — even ones not in our build closure, because
# pnpm-lock.yaml references them all.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY tsconfig.base.json ./
COPY apps/server/package.json apps/server/
COPY apps/worker/package.json apps/worker/
COPY packages/config/package.json packages/config/
COPY packages/core/package.json packages/core/
COPY packages/github/package.json packages/github/
COPY packages/observability/package.json packages/observability/
COPY packages/queue/package.json packages/queue/
COPY packages/reviewer/package.json packages/reviewer/
COPY packages/storage/package.json packages/storage/
COPY packages/web/package.json packages/web/
RUN pnpm install --frozen-lockfile --filter "@gcr/reviewer..."

# Sources — only what the reviewer + its deps need.
COPY packages/core packages/core
COPY packages/observability packages/observability
COPY packages/reviewer packages/reviewer

# Build in topological order. `--filter @gcr/reviewer...` would do this for
# us via pnpm's dep graph, but spelling it out keeps the failure mode obvious
# if any one stage breaks.
RUN pnpm --filter @gcr/core build \
 && pnpm --filter @gcr/observability build \
 && pnpm --filter @gcr/reviewer build

# ── runtime ────────────────────────────────────────────────────────────────
FROM gcr.io/distroless/nodejs20-debian12:nonroot
WORKDIR /sandbox

# Bring built artifacts and the production-only deps.
COPY --from=build /repo/node_modules /sandbox/node_modules
COPY --from=build /repo/packages/core/dist /sandbox/packages/core/dist
COPY --from=build /repo/packages/core/package.json /sandbox/packages/core/package.json
COPY --from=build /repo/packages/observability/dist /sandbox/packages/observability/dist
COPY --from=build /repo/packages/observability/package.json /sandbox/packages/observability/package.json
COPY --from=build /repo/packages/reviewer/dist /sandbox/packages/reviewer/dist
COPY --from=build /repo/packages/reviewer/package.json /sandbox/packages/reviewer/package.json

# Non-root by default in distroless:nonroot (uid 65532); override to 10001 at run time.
USER 65532

# The entrypoint reads /etc/secrets/anthropic, then unlinks it, then runs Claude.
ENTRYPOINT ["/nodejs/bin/node", "--enable-source-maps", "/sandbox/packages/reviewer/dist/sandbox/entrypoint.js"]
