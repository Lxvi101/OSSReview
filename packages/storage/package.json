{
  "name": "@gcr/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kysely + better-sqlite3 + numbered raw-SQL migrations + repositories.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./migrations": "./dist/migrations/run.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -R src/migrations/sql dist/migrations/sql",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "migrate": "node --enable-source-maps dist/migrations/cli.js up",
    "migrate:dry-run": "node --enable-source-maps dist/migrations/cli.js up --dry-run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@gcr/core": "workspace:*",
    "@gcr/observability": "workspace:*",
    "better-sqlite3": "^11.5.0",
    "kysely": "^0.27.4",
    "sodium-native": "^4.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
