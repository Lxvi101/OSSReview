{
  "name": "@gcr/reviewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reviewer port + local Claude/Codex adapters + legacy Docker sandbox runner.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./claude": "./dist/claude/index.js",
    "./codex": "./dist/codex/index.js",
    "./sandbox": "./dist/sandbox/index.js",
    "./testing": "./dist/testing/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@gcr/core": "workspace:*",
    "@gcr/observability": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "dockerode": "^4.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.31",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
