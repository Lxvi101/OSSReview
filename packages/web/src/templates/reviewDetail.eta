<div hx-get="/reviews/<%= it.review.id %>/fragment"
     hx-trigger="<%= it.review.terminal ? 'none' : 'every 2s' %>"
     hx-swap="outerHTML">
  <h1>Review <%= it.review.id %></h1>

  <p>
    <span class="state state-<%= it.review.state %>"><%= it.review.state %></span>
    <strong><%= it.review.repo %></strong> #<%= it.review.prNumber %>
    · trigger=<%= it.review.trigger %>
    · attempts=<%= it.review.attempts %>
    <% if (it.review.durationMs != null) { %>· <%= it.review.durationMs %>ms<% } %>
    <% if (it.review.costUsd != null) { %>· $<%= it.review.costUsd.toFixed(4) %><% } %>
  </p>

  <% if (it.review.errorMessage) { %>
    <pre class="error"><%= it.review.errorMessage %></pre>
  <% } %>

  <h2>Findings (<%= it.findings.length %>)</h2>
  <% if (it.findings.length === 0) { %>
    <p class="empty">No findings.</p>
  <% } else { %>
    <ul class="findings">
      <% it.findings.forEach(function(f) { %>
        <li class="finding finding-<%= f.severity %>">
          <span class="severity"><%= f.severity %></span>
          <span class="path"><%= f.filePath %><% if (f.lineStart) { %>:<%= f.lineStart %><% } %></span>
          <pre class="body"><%= f.body %></pre>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
