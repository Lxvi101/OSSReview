<h1>Reviews</h1>

<table class="table">
  <thead><tr><th>State</th><th>Repository</th><th>PR</th><th>Trigger</th><th>Created</th><th>Cost</th></tr></thead>
  <tbody>
    <% it.reviews.forEach(function(r) { %>
      <tr>
        <td><a href="/reviews/<%= r.id %>"><span class="state state-<%= r.state %>"><%= r.state %></span></a></td>
        <td><%= r.repo %></td>
        <td>#<%= r.prNumber %></td>
        <td><%= r.trigger %></td>
        <td><%= r.createdAt %></td>
        <td><%= r.costUsd != null ? '$' + r.costUsd.toFixed(2) : '—' %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
