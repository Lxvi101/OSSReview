<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= it.ctx.title %> — GitHub Code Reviewer</title>
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/htmx.min.js" defer></script>
  <script src="/static/alpine.min.js" defer></script>
</head>
<body class="app">
  <header class="topbar">
    <a class="brand" href="/">GitHub Code Reviewer</a>
    <nav>
      <a href="/" class="<%= it.ctx.currentPath === '/' ? 'active' : '' %>">Dashboard</a>
      <a href="/repositories" class="<%= it.ctx.currentPath.startsWith('/repositories') ? 'active' : '' %>">Repositories</a>
      <a href="/reviews" class="<%= it.ctx.currentPath.startsWith('/reviews') ? 'active' : '' %>">Reviews</a>
      <a href="/audit" class="<%= it.ctx.currentPath === '/audit' ? 'active' : '' %>">Audit</a>
      <a href="/settings" class="<%= it.ctx.currentPath.startsWith('/settings') ? 'active' : '' %>">Settings</a>
    </nav>
  </header>
  <main class="content">
    <%~ it.body %>
  </main>
  <footer class="footer">
    <span>GitHub Code Reviewer</span>
    <span>Self-hosted · Apache-2.0</span>
  </footer>
</body>
</html>
