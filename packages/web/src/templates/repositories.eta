<h1>Repositories</h1>

<% if (it.justRefreshed) { %>
  <p style="background:#dafbe1;color:#1a7f37;padding:8px 12px;border-radius:6px;font-size:13px">
    Refresh queued — the worker is reconciling with GitHub right now. Refresh this
    page in a few seconds; the "Recent activity" table below will show what changed.
  </p>
<% } %>

<% if (it.installations.length > 0) { %>
  <section class="card" style="padding:12px 16px;margin-bottom:16px">
    <h2 style="margin:0 0 8px 0;font-size:14px">Edit on GitHub</h2>
    <p style="color:var(--muted);font-size:13px;margin:0 0 8px 0">
      Repository access is managed in the App's installation settings on GitHub.
      Adds appear here within ~1 second of saving. Removes sometimes don't fire
      a webhook (notably from "All repositories" mode) — use the
      <strong>Refresh from GitHub</strong> button to reconcile in those cases.
    </p>
    <% it.installations.forEach(function(i) { %>
      <a class="btn" target="_blank" rel="noopener" href="<%= i.configureUrl %>"
         style="margin-right:8px;margin-bottom:6px">
        Configure <%= i.owner %> (<%= i.count %> repo<%= i.count === 1 ? '' : 's' %>) ↗
      </a>
    <% }) %>
    <% if (it.installNewUrl) { %>
      <a class="btn" target="_blank" rel="noopener" href="<%= it.installNewUrl %>"
         style="background:transparent;color:var(--accent);border:1px solid var(--accent);margin-right:8px">
        Install on a new account ↗
      </a>
    <% } %>
    <form method="post" action="/repositories/refresh" style="display:inline-block">
      <button type="submit" class="btn"
              style="background:transparent;color:var(--fg);border:1px solid var(--border)">
        Refresh from GitHub
      </button>
    </form>
  </section>
<% } %>

<p style="color:var(--muted);font-size:13px">
  <strong><%= it.enabledCount %></strong> active
  <% if (it.disabledCount > 0) { %>
    · <strong><%= it.disabledCount %></strong> revoked by GitHub
    <% if (it.showAll) { %>
      · <a href="/repositories">hide revoked</a>
    <% } else { %>
      · <a href="/repositories?show=all">show all</a>
    <% } %>
  <% } %>
</p>

<% if (it.repositories.length === 0) { %>
  <% if (it.showAll || it.disabledCount === 0) { %>
    <p class="empty">
      No repositories tracked yet. Install the GitHub App on a repo and it will
      appear here automatically.
    </p>
    <p>
      <% if (it.installNewUrl) { %>
        <a class="btn" target="_blank" rel="noopener" href="<%= it.installNewUrl %>">Install on GitHub →</a>
      <% } else { %>
        <a class="btn" href="/setup/install">Install on a repository →</a>
      <% } %>
    </p>
  <% } else { %>
    <p class="empty">
      No active repositories. <a href="/repositories?show=all">Show <%= it.disabledCount %> revoked</a>.
    </p>
  <% } %>
<% } else { %>
  <table class="table">
    <thead><tr><th>Repository</th><th>State</th><th>Last seen</th><th></th></tr></thead>
    <tbody>
      <% it.repositories.forEach(function(r) { %>
        <tr<% if (!r.enabled) { %> style="opacity:0.55"<% } %>>
          <td><a href="/repositories/<%= r.id %>"><%= r.fullName %></a></td>
          <td>
            <% if (r.enabled) { %>
              <span class="state state-completed">active</span>
            <% } else { %>
              <span class="state state-cancelled">revoked</span>
            <% } %>
          </td>
          <td><%= r.updatedAt %></td>
          <td><a href="/repositories/<%= r.id %>">settings</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<% if (it.recentEvents.length > 0) { %>
  <section style="margin-top:24px">
    <h2 style="font-size:14px">Recent activity</h2>
    <p style="color:var(--muted);font-size:12px;margin:0 0 8px 0">
      The last few install-related events the worker processed. If you edited
      access on GitHub but don't see a fresh entry here within a few seconds,
      GitHub didn't actually send a webhook (most often: nothing changed in
      the selection, or you saved while in "All repositories" mode without
      adding any new repos).
    </p>
    <table class="table">
      <thead><tr><th>When</th><th>Event</th><th>Subject</th><th>Detail</th></tr></thead>
      <tbody>
        <% it.recentEvents.forEach(function(e) { %>
          <tr>
            <td><%= e.at %></td>
            <td><%= e.kind %></td>
            <td><%= e.subjectType %></td>
            <td style="font-family:ui-monospace,SF Mono,Menlo,monospace;font-size:11px"><%= e.data %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
<% } %>
