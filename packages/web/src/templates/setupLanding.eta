<h1>Set up the GitHub App</h1>

<p>
  This wizard will create a GitHub App with the right permissions and install
  it on the repositories you choose. The app will post reviews under its own
  identity — you don't need to share a personal access token.
</p>

<% if (!it.preflight.ok) { %>
  <div class="card" style="background:#ffebe9;border-color:#d1242f">
    <h2 style="color:#d1242f;margin-top:0">PUBLIC_URL is not acceptable to GitHub</h2>
    <p><strong>Currently:</strong> <code><%= it.publicUrl %></code></p>
    <p><strong>Reason:</strong> <%= it.preflight.reason %></p>
    <p><strong>What to do:</strong> <%= it.preflight.suggestion %></p>
    <p>Update <code>.env</code>, restart the stack, then refresh this page.</p>
  </div>
<% } else { %>
  <p style="color:#6a737d;font-size:13px">
    Webhook URL: <code><%= it.publicUrl %>/webhooks/github</code>
  </p>
  <form action="/setup/manifest" method="post">
    <input type="hidden" name="_csrf" value="<%= it.ctx.csrfToken %>">
    <label>
      App name
      <input name="name" value="<%= it.suggestedName %>" required>
    </label>
    <p>The form below submits to GitHub. They'll redirect back to this server with the new App's credentials.</p>
    <button type="submit" class="btn">Create GitHub App →</button>
  </form>
<% } %>
