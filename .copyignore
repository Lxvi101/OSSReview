# Autogenerated .copyignore. Edit to customize.
# Supports glob patterns and wildcards (same syntax as .gitignore).
#
# Special flags (prefix with @):
#   @include-tree    - Include file/folder tree at the beginning of output

@include-tree

# VCS & editor
.git/
.gitignore
.svn/
.hg/
.idea/
.vscode/

# Python caches
__pycache__/
*.pyc
*.pyo

# Builds & caches
dist/
build/
out/
.cache/
.parcel-cache/
.turbo/
.next/
.nuxt/
.svelte-kit/
coverage/
bin/
obj/
target/

# Dependencies
node_modules/
.yarn/
.pnpm-store/

# Lock files
pnpm-lock.yaml
package-lock.json
yarn.lock
composer.lock
Gemfile.lock
Cargo.lock
*.lock

# Env & logs
.env
.env.*
*.log
yarn-error.log
npm-debug.log

# OS files
.DS_Store
Thumbs.db

# Common binary/generated file extensions
*.vsix
*.ico
*.png
*.jpg
*.jpeg
*.gif
*.pdf
*.zip
*.tar.gz
*.exe
*.dll
*.so
*.dylib
*.svg
*.ai

# Ignore this file by default
.copyignore

# From .gitignore
# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo
.turbo/

# Test coverage
coverage/
*.lcov

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Environment & secrets
.env
.env.*
!.env.example
*.bak
*.pem
*.key
secrets/
!packages/storage/src/secrets/
*.secret

# Runtime data
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.sample
*.swp
*.swo

