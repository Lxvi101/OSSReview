{
  "name": "@gcr/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTTP: webhooks, UI, JSON API, /health, /metrics. Composition root for the web tier.",
  "main": "./dist/main.js",
  "exports": {
    ".": "./dist/main.js",
    "./app": "./dist/app.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps dist/main.js",
    "dev": "node --enable-source-maps --env-file=.env --watch src/main.ts",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@gcr/config": "workspace:*",
    "@gcr/core": "workspace:*",
    "@gcr/github": "workspace:*",
    "@gcr/observability": "workspace:*",
    "@gcr/queue": "workspace:*",
    "@gcr/storage": "workspace:*",
    "@fastify/cookie": "^11.0.1",
    "@fastify/formbody": "^8.0.1",
    "@fastify/static": "^8.0.2",
    "argon2": "^0.41.1",
    "fastify": "^5.1.0",
    "kysely": "^0.27.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
