# ─────────────────────────────────────────────────────────────────────────────
# GitHub Code Reviewer — Bootstrap configuration
#
# Only the values below are read from the environment. Everything else
# (GitHub App credentials, prompt customizations, path filters)
# is configured at runtime through the web UI and stored encrypted in the DB.
#
# Copy this file to `.env` and fill in the required fields.
# Validation runs at boot. A missing or malformed value will exit the process
# with code 78 and a single human-readable block listing every offending var.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# 'development' | 'production' | 'test'
NODE_ENV=development

# Public URL the GitHub webhook delivery hits (e.g. https://reviewer.example.com).
# In local dev this is your smee.io URL — see README "Local development".
PUBLIC_URL=http://localhost:3000

# 32-byte hex key. Generate with: openssl rand -hex 32
# Used to encrypt at-rest secrets (GitHub App private key, webhook secret).
# Rotating it requires `pnpm gcr secrets rotate --new-key=...` (see operations.md).
SECRETS_KEY=

# Random string ≥ 32 chars. Generate with: openssl rand -base64 48
# Signs the admin session cookie.
SESSION_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────

# HTTP server bind port (default 3000)
PORT=3000

# SQLite database path (default /var/lib/gcr/data.sqlite inside the container)
DATABASE_PATH=./data/gcr.sqlite

# Default reviewer provider. Per-repository settings can override this.
# Values: claude | codex
REVIEWER_PROVIDER=claude

# Hard wall-clock cap on a single host-local review run (default 20 min).
REVIEWER_TIMEOUT_MS=1200000

# Claude Code subscription-backed reviewer. With compose, log in with:
#   docker compose -f docker/compose.yml exec worker claude auth login
CLAUDE_CODE_BINARY=claude
CLAUDE_CODE_HOME=
CLAUDE_CODE_MODEL=claude-sonnet-4-5

# Codex subscription-backed reviewer. With compose, log in with:
#   docker compose -f docker/compose.yml exec worker codex login
CODEX_BINARY=codex
CODEX_HOME=
CODEX_MODEL=gpt-5-codex

# Legacy Anthropic API key for the old Docker sandbox path. Not required by the
# default host-local reviewer.
ANTHROPIC_API_KEY=

# 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace'  (default 'info')
LOG_LEVEL=info

# Legacy Docker engine endpoint used by the old per-review sandbox path.
SANDBOX_DOCKER_HOST=unix:///var/run/docker.sock

# Legacy OCI image (digest-pinned in production) used as the sandbox.
SANDBOX_IMAGE=

# Legacy hard wall-clock cap on a single sandbox review run (default 20 min).
SANDBOX_TIMEOUT_MS=1200000

# Prometheus metrics endpoint bind address. Defaults to localhost-only.
METRICS_BIND=127.0.0.1:9090

# OpenTelemetry OTLP endpoint (optional). Tracing is initialized but disabled
# until this is set.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Local-dev tunneling (optional) ──────────────────────────────────────────
# `pnpm tunnel:ngrok` prefers an existing ngrok session running on the host
# (i.e. `ngrok http 3000 --domain=...` you ran in another terminal). The
# variables below are needed ONLY if you let compose run ngrok for you.
#
# Free tier auth token: https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=
#
# Reserved free-tier domain (one per account). Setting this keeps PUBLIC_URL
# stable across restarts — required if you don't want to re-edit the GitHub
# App's webhook URL every dev session. Get it at:
# https://dashboard.ngrok.com/cloud-edge/domains
# NGROK_DOMAIN=
