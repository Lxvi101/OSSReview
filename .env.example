# GitHub Code Reviewer — environment.
#
# Copy to `.env` and fill in. Validation runs at boot — a missing or
# malformed value exits the process with code 78 and a single human-readable
# block listing every offending var.
#
# Easiest path: `pnpm bootstrap` runs `init-env` for you, which generates
# SECRETS_KEY and SESSION_SECRET and writes this file mode 600.

# ── Required ─────────────────────────────────────────────────────────────────

# 'development' | 'production' | 'test'
NODE_ENV=development

# Public URL the GitHub webhook delivery hits.
# For local dev: a smee.io channel URL (https://smee.io/new).
PUBLIC_URL=http://localhost:3000

# 32-byte hex key. Generate with: openssl rand -hex 32
SECRETS_KEY=

# Random ≥32 chars. Generate with: openssl rand -base64 48
SESSION_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────

# HTTP server bind port (default 3000)
PORT=3000

# SQLite database path (default /var/lib/gcr/data.sqlite inside the container)
DATABASE_PATH=./data/gcr.sqlite

# Default reviewer provider. Per-repository settings can override this.
# Values: claude | codex
REVIEWER_PROVIDER=claude

# Hard wall-clock cap on a single review run (default 20 min).
REVIEWER_TIMEOUT_MS=1200000

# Claude Code subscription-backed reviewer.
# After compose is up, log in with:
#   docker compose -f docker/compose.yml exec worker claude auth login
CLAUDE_CODE_BINARY=claude
CLAUDE_CODE_HOME=
CLAUDE_CODE_MODEL=claude-sonnet-4-5

# Codex subscription-backed reviewer.
#   docker compose -f docker/compose.yml exec worker codex login
CODEX_BINARY=codex
CODEX_HOME=
CODEX_MODEL=gpt-5-codex

# 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace'
LOG_LEVEL=info

# Prometheus metrics bind. Defaults to localhost-only.
METRICS_BIND=127.0.0.1:9090
